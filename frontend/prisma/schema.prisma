generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DocumentType {
  PAST_PAPER
  LECTURE_NOTE
  MODULE_CONTENT
  TEXTBOOK
  OTHER
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum QuestionType {
  MCQ
  STRUCTURED
  ESSAY
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum MockExamStatus {
  DRAFT
  READY
  COMPLETED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subjects       Subject[]
  mockExams      MockExam[]
  revisionItems  RevisionItem[]
  generatedItems GeneratedQuestion[]

  @@index([email])
}

model Subject {
  id             String  @id @default(cuid())
  name           String
  code           String?
  educationLevel String?
  institution    String?
  examType       String?
  description    String?
  archived       Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documents          Document[]
  topics             Topic[]
  questions          Question[]
  predictions        Prediction[]
  generatedQuestions GeneratedQuestion[]
  mockExams          MockExam[]
  revisionItems      RevisionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, archived])
}

model Document {
  id       String  @id @default(cuid())
  title    String
  fileName String
  fileType String
  mimeType String?
  fileSize Int?

  documentType DocumentType
  year         Int?
  description  String?

  storageKey String
  storageUrl String?

  processingStatus ProcessingStatus @default(PENDING)
  processingError  String?

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  questions Question[]
  topics    DocumentTopic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
  @@index([processingStatus])
  @@index([documentType])
}

model Topic {
  id          String  @id @default(cuid())
  name        String
  description String?

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  documents          DocumentTopic[]
  questions          Question[]
  predictions        Prediction[]
  generatedQuestions GeneratedQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectId, name])
  @@index([subjectId])
}

model DocumentTopic {
  documentId String
  topicId    String

  confidence Float?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  topic    Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([documentId, topicId])
  @@index([topicId])
}

model Question {
  id     String       @id @default(cuid())
  text   String
  type   QuestionType
  marks  Int?
  year   Int?
  number String?
  answer String?

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
  @@index([documentId])
  @@index([topicId])
  @@index([year])
  @@index([type])
}

model Prediction {
  id String @id @default(cuid())

  title       String
  explanation String?
  score       Float
  rank        Int?

  recurrenceScore Float?
  similarityScore Float?
  recencyScore    Float?
  importanceScore Float?

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
  @@index([topicId])
  @@index([score])
}

model GeneratedQuestion {
  id String @id @default(cuid())

  questionText String
  type         QuestionType
  difficulty   DifficultyLevel @default(MEDIUM)

  marks          Int?
  explanation    String?
  keyPoints      String?
  sourceEvidence String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  answer GeneratedAnswer?

  mockExamQuestions MockExamQuestion[]
  revisionItems     RevisionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([subjectId])
  @@index([topicId])
  @@index([type])
}

model GeneratedAnswer {
  id String @id @default(cuid())

  answerText    String
  explanation   String?
  keyPoints     String?
  marksGuidance String?

  generatedQuestionId String            @unique
  generatedQuestion   GeneratedQuestion @relation(fields: [generatedQuestionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MockExam {
  id String @id @default(cuid())

  title      String
  duration   Int
  totalMarks Int?
  status     MockExamStatus @default(DRAFT)

  instructions String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  questions MockExamQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([subjectId])
}

model MockExamQuestion {
  id String @id @default(cuid())

  position Int
  marks    Int?

  mockExamId String
  mockExam   MockExam @relation(fields: [mockExamId], references: [id], onDelete: Cascade)

  generatedQuestionId String
  generatedQuestion   GeneratedQuestion @relation(fields: [generatedQuestionId], references: [id], onDelete: Cascade)

  @@unique([mockExamId, generatedQuestionId])
  @@index([mockExamId, position])
}

model RevisionItem {
  id String @id @default(cuid())

  note      String?
  important Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  generatedQuestionId String?
  generatedQuestion   GeneratedQuestion? @relation(fields: [generatedQuestionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([subjectId])
}
