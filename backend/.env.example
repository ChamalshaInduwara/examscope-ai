# Application
APP_NAME=ExamScope AI API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# Internal authentication between Next.js and FastAPI
INTERNAL_API_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter fallback / alternative provider
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# AI generation timeout
GENERATION_TIMEOUT_SECONDS=30
